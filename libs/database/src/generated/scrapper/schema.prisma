generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/scrapper"
}

datasource db {
  provider = "mongodb"
  url      = env("SCRAPPER_DATABASE_URL")
}

model myntraScrapeProgress {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  rootCategory  String
  groupCategory String
  categorySlug  String

  status String // pending | running | completed

  currentPage Int  @default(1)
  totalPages  Int?

  totalProducts Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([rootCategory, groupCategory, categorySlug])
}

model MyntraRootCategory {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique

  groups MyntraGroupCategory[]

  createdAt DateTime @default(now())

  @@map("myntra_root_categories")
}

model MyntraGroupCategory {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  slug  String
  title String

  rootCategoryId String             @db.ObjectId
  rootCategory   MyntraRootCategory @relation(fields: [rootCategoryId], references: [id])

  categories MyntraCategory[]

  createdAt DateTime @default(now())

  @@unique([slug, rootCategoryId])
  @@map("myntra_group_categories")
}

model MyntraCategory {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  slug  String
  title String
  href  String

  groupCategoryId String              @db.ObjectId
  groupCategory   MyntraGroupCategory @relation(fields: [groupCategoryId], references: [id])

  products MyntraProduct[]

  createdAt DateTime @default(now())

  @@unique([slug, groupCategoryId])
  @@map("myntra_categories")
}

model MyntraProduct {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  productCode String @unique
  href        String

  brand String
  title String

  rating      String?
  ratingCount String?

  size String?
  SRP  String?
  MRP  String?

  images          String[]
  productDetails  String[]
  sizeAndFit      String[]
  materialAndCare String[]

  specification String[]
  seller        String[]

  categoryId String         @db.ObjectId
  category   MyntraCategory @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("myntra_products_v1")
}

/**
 * =========================
 * BLINKIT
 * =========================
 */

model BlinkitProduct {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  sku      String  @unique
  title    String
  brand    String?
  price    Float
  mrp      Float?
  quantity String?

  images   String[]
  category String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blinkit_products")
}

/**
 * =========================
 * LIMEROAD
 * =========================
 */

model LimeroadProduct {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  itemId String  @unique
  title  String
  brand  String?

  price String
  mrp   String?

  images   String[]
  category String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("limeroad_products")
}
