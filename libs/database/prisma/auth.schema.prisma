generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/auth"
}

datasource db {
  provider = "mongodb"
  url      = env("AUTH_DATABASE_URL")
}


model Users {
  id    String @db.ObjectId @id @default(auto()) @map("_id")
  
  service String?


  email String? @unique
  phone_number String? @unique
  phone_code String? 


  name  String?
  password String?

  // isAgreedToT&C Boolean @default(false)

  
  isEmailVerified Boolean @default(false)
  isPhoneNumberVerified Boolean @default(false)

  authProvider String?  
  providerId   String?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}
