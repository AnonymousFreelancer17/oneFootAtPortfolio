{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "../../dist/libs/error_handler",

    "declaration": true,
    "emitDeclarationOnly": true,

    "module": "ESNext",
