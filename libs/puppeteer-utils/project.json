{
  "name": "puppeteer-utils",
  "sourceRoot": "libs/puppeteer-utils/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/libs/puppeteer-utils",
        "main": "libs/puppeteer-utils/src/index.ts",
        "tsConfig": "libs/puppeteer-utils/tsconfig.app.json"
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "puppeteer-utils:build"
      }
    }
  }
}
