{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // "ignoreDeprecations" : "6.0",
    "rootDir": "./src",
    "outDir": "../../dist/libs/puppeteer-utils",
    "tsBuildInfoFile": "../../dist/libs/puppeteer-utils/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*.ts"
, "src/userAgents.ts"  ],
  "references": [],
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
