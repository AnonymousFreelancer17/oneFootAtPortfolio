{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "rootDir": "../../",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": [
      "node",
      "express"
    ],
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "../../libs/**/*.ts"
  ],
  "exclude": ["**/*.spec.ts"],
  "references": [
    {
      "path": "../../libs/error_handler/tsconfig.lib.json"
    },
    {
      "path": "../../libs/database/tsconfig.lib.json"
    }
  ]
}
