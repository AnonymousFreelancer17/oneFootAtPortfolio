<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>One_foot Labs Activation Email</title>
</head>
<body style="margin: 0; padding: 0; background-color: #fafafa; font-family: Arial, Helvetica, sans-serif; font-size: 16px; color: #222;">

  <table width="100%" cellpadding="0" cellspacing="0" bgcolor="#fafafa">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" bgcolor="#ffffff" style="border-radius: 8px; overflow: hidden;">
          
          <!-- Header -->
          <tr>
            <td align="center" bgcolor="#0070f3" style="padding: 24px; color: #ffffff; font-size: 24px; font-weight: bold;">
              Welcome to One_Foot Labs- portfolio
            </td>
          </tr>
          
          <!-- Body -->
          <tr>
            <td style="padding: 24px;">
              <p style="margin: 0 0 16px;">Hello <strong><%= name %></strong>,</p>
              <p style="margin: 0 0 16px;">Thank you for registering with E-commerce. To activate your account, please use the following activation code:</p>
              <h2 style="color: #0070f3; font-size: 28px; margin: 16px 0;"><%= otp %></h2>
              <p style="margin: 0 0 16px;">Please enter this code on the verification page within the next 5 minutes.</p>
              <p>If you did not logged for an E-commerce account, please ignore this email.</p>
            </td>
          </tr>
          
          <!-- Footer -->
          <tr>
            <td align="center" style="padding: 16px; font-size: 14px; color: #666;">
              If you have any questions, contact us at <a href="mailto:anonymousfreelancer17@gmail.com" style="color: #0070f3; text-decoration: none;">anonymousfreelancer17@gmail.com</a>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
