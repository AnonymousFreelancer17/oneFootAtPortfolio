{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "baseUrl": ".",
    "paths": {
      "@ui/*" : ["libs/ui/src/*"],
      "@puppeteer": ["libs/puppeteer-utils/src/index.ts"],
      "@puppeteer/*": ["libs/puppeteer-utils/src/*"],
      "@one-foot-at-portfolio/database": ["libs/database/src"],
      "@one-foot-at-portfolio/database/*": ["libs/database/src/*"],
      "@one-foot-at-portfolio/error_handler": ["libs/error_handler/src"],
      "@one-foot-at-portfolio/error_handler/*": ["libs/error_handler/src/*"]
    }
  }
}
